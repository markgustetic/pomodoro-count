# Template for the Homebrew cask. The release workflow substitutes __VERSION__
# and __SHA256__ and pushes the result to markgustetic/homebrew-tap as
# Casks/pomodoro-count.rb. Don't edit the copy in the tap by hand — edit this.
cask "pomodoro-count" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "https://github.com/markgustetic/pomodoro-count/releases/download/v#{version}/PomodoroCount-#{version}.zip"
  name "Pomodoro Count"
  desc "Menu bar app that counts pomodoros you finish on external hardware"
  homepage "https://github.com/markgustetic/pomodoro-count"

  livecheck do
    url :url
    strategy :github_latest
  end

  # The app updates itself through Sparkle. Without this, Homebrew also thinks
  # it owns upgrades: `brew upgrade` would reinstall over a copy Sparkle had
  # already moved on, and the two would fight. With it, brew leaves upgrades
  # alone unless asked with --greedy.
  auto_updates true

  depends_on macos: :sonoma

  app "Pomodoro Count.app"

  uninstall quit: "com.markg.pomodorocount"

  zap trash: [
    "~/Library/Application Support/PomodoroCount",
  ]

  # Releases are signed with a Developer ID and notarized, so there is no
  # quarantine workaround to document here any more. What is left is the thing
  # people genuinely miss: a menu-bar-only app looks like it didn't launch.
  caveats <<~EOS
    The app lives in the menu bar and has no Dock icon — look top-right after
    launching it.
  EOS
end
